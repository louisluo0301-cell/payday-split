# Copy to .env and fill in. Use a THROWAWAY testnet wallet only.
# Never commit .env or paste the private key anywhere.
PRIVATE_KEY=0x...

# Destination chain: Ethereum Sepolia by default.
DEST_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEST_CHAIN_ID=11155111
CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4
# Base Sepolia: 84532 / 0x476F44b11F5C942c58f4c8E3d0300E5710743585
# Unichain Sepolia: 1301 / 0x775c9B990ADe401060B78D0e98684eEf8d2466C1

# Alias kept for compatibility with the starter scripts.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Reactive side (Lasna testnet).
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# Filled in by the deploy scripts, in this order:
TOKEN_ADDR=
SPLIT_ADDR=
REACTIVE_ADDR=

# Demo waterfall (3 buckets). The UI can replace these later.
RENT_PAYEE=0x000000000000000000000000000000000000dEaD
TAX_PAYEE=0x000000000000000000000000000000000000bEEF
SAVINGS_PAYEE=0x000000000000000000000000000000000000cafE
RENT_FIXED=300000000      # 300 USDC (6 decimals)
TAX_BPS=2500              # 25%
SAVINGS_BPS=1500          # 15%

# Optional knobs
# Use a real USDC address instead of deploying DemoUSDC:
# TOKEN_ADDR=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
MAX_CALLBACKS=100
REACTIVE_FUND_WEI=500000000000000000   # 0.5 lREACT
CALLBACK_FUND_WEI=20000000000000000    # 0.02 ETH

# Minimum incoming Transfer (token base units) that triggers a callback. 1e6 = 1 USDC for 6-dp tokens.
MIN_PAYCHECK=1000000
